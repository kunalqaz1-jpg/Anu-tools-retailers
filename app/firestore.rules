rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff'
        )
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    // Products: readable by active status, writable only by admins
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Categories: readable by anyone, writable only by admins
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Business Settings: readable by anyone, writable only by admins
    match /businessSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders:
    // - Retailer can create only their own order
    // - Retailer can read only their own orders
    // - Admin can read and update all orders
    // - Retailer can update their own order (e.g. submit payment proof/reference)
    //   provided they DO NOT set paymentStatus to 'PAID' or change ownership
    match /orders/{orderId} {
      allow create: if isAuthenticated()
                    && request.resource.data.retailerId == request.auth.uid;

      allow read: if (isAuthenticated() && resource.data.retailerId == request.auth.uid)
                  || isAdmin();

      allow update: if isAdmin() || (
        isAuthenticated()
        && resource.data.retailerId == request.auth.uid
        && request.resource.data.retailerId == resource.data.retailerId
        && request.resource.data.paymentStatus != 'PAID'
      );

      allow delete: if false;
    }

    // Admin Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Retailers collection:
    // - Retailer can read/write ONLY their own profile
    // - Admins can read all retailers
    match /retailers/{retailerId} {
      allow read: if (isAuthenticated() && request.auth.uid == retailerId) || isAdmin();
      allow write: if (isAuthenticated() && request.auth.uid == retailerId) || isAdmin();
    }
  }
}
